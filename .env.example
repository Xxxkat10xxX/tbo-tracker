# tbo-tracker — настройки Docker Compose. Скопируйте в .env (sh deploy/docker/init.sh) и отредактируйте.
# Паролей здесь нет и быть не должно: пароль PostgreSQL — secrets/db_password.txt, администратор — через код настройки.

# Где публикуется HTTP-порт приложения: 127.0.0.1 — только на этом сервере (за HTTPS-прокси),
# 0.0.0.0 — для всей локальной сети (без HTTPS пароли передаются открыто!)
TBO_BIND=127.0.0.1
TBO_HTTP_PORT=8000

# HTTPS (compose.https.yaml): доменное имя сервера и выпуск сертификата: acme (Let's Encrypt) или internal (свой УЦ в локальной сети)
TBO_DOMAIN=tbo.example.com
TBO_TLS=acme

# Имена сайта, по которым разрешён доступ (защита от DNS rebinding), через запятую. Пусто — любые.
# localhost и имя из TBO_DOMAIN (при HTTPS) разрешены всегда. Пример: TBO_ALLOWED_HOSTS=tbo.local,192.168.1.50
TBO_ALLOWED_HOSTS=

# Демо-данные, сценарии проверки и «Сбросить демо-данные» (стирает базу!). Для рабочей эксплуатации — 0
TBO_DEMO_MODE=0

# Сессии: выход после бездействия (мин) и предельный срок сессии (ч)
TBO_SESSION_IDLE_MIN=120
TBO_SESSION_MAX_HOURS=12
# Защита от перебора: неудачных попыток до блокировки и первая блокировка (мин, далее удваивается)
TBO_LOGIN_MAX_FAILS=5
TBO_LOGIN_LOCK_MIN=15

# Хранение журнала аудита (дней) и лимиты загрузки (МБ)
TBO_AUDIT_RETENTION_DAYS=365
TBO_MAX_UPLOAD_MB=25
TBO_MAX_BACKUP_UPLOAD_MB=512

# Документация API (/docs) — только администратору; включайте лишь при необходимости
TBO_API_DOCS=0
TBO_LOG_LEVEL=info
