#!/usr/bin/env bash
# tbo-ctl — управление сервисом tbo-tracker на Raspberry Pi. Справка: sudo tbo-ctl help
# shellcheck disable=SC1090  # источник настроек — /etc/tbo-tracker/tbo.env
set -euo pipefail

APP_DIR=/opt/tbo-tracker
ETC_DIR=/etc/tbo-tracker
ENV_FILE=$ETC_DIR/tbo.env
SVC=tbo-tracker
SVC_USER=tbo

die() { printf '\033[1;31m[x]\033[0m %s\n' "$*" >&2; exit 1; }
say() { printf '\033[1;34m==>\033[0m %s\n' "$*"; }

help() {
  cat <<'EOF'
tbo-ctl — управление tbo-tracker

  status               состояние сервиса и Raspberry Pi (температура, питание, память, диск, адреса)
  logs                 журнал сервиса в реальном времени (Ctrl+C — выход)
  start | stop | restart
  backup               резервная копия сейчас (база + фото)
  backups              список копий
  restore ИМЯ|ПУТЬ.zip восстановление из копии (сервис останавливается на время операции)
  update               обновить из git (перед обновлением — резервная копия)
  password [ПАРОЛЬ]    задать/сменить пароль входа (без аргумента — спросит)
  nopassword           отключить вход по паролю
  port N               сменить порт веб-интерфейса
  reset-demo           пересоздать демо-данные (все изменения будут потеряны)
  notify-test          тестовое сообщение в Telegram / webhook
  uninstall [--purge]  удалить сервис (--purge — вместе с данными и настройками)
EOF
}

[[ ${1:-help} == help || ${1:-} == -h || ${1:-} == --help ]] && { help; exit 0; }
[[ $(id -u) -eq 0 ]] || exec sudo -- "$0" "$@"
[[ -f $ENV_FILE ]] || die "tbo-tracker не установлен ($ENV_FILE нет). Запустите deploy/raspberry-pi/install.sh"

envget() { (set -a; . "$ENV_FILE"; eval "echo \"\${$1:-}\""); }
admin() {
  runuser -u "$SVC_USER" -- bash -c 'set -a; . "$0"; set +a; cd /opt/tbo-tracker; exec .venv/bin/python -m app.admin "$@"' "$ENV_FILE" "$@"
}
setenv() {   # setenv КЛЮЧ ЗНАЧЕНИЕ — значение без одинарных кавычек
  local key=$1 val=$2
  if grep -q "^$key=" "$ENV_FILE"; then
    sed -i "s|^$key=.*|$key='$val'|" "$ENV_FILE"
  else
    printf "%s='%s'\n" "$key" "$val" >>"$ENV_FILE"
  fi
}
url() {
  local p; p=$(envget TBO_PORT)
  [[ $p == 80 ]] && echo "http://$(hostname).local" || echo "http://$(hostname).local:$p"
}
wait_up() {
  local p; p=$(envget TBO_PORT)
  for _ in $(seq 1 40); do curl -fsS "http://127.0.0.1:$p/health" >/dev/null 2>&1 && return 0; sleep 1; done
  die "Сервис не ответил: sudo tbo-ctl logs"
}

cmd=$1; shift || true
case "$cmd" in
  status)
    systemctl --no-pager --lines=0 status "$SVC" | head -4 || true
    echo
    admin status
    ;;
  logs) exec journalctl -u "$SVC" -f -n 100 ;;
  start|stop|restart)
    systemctl "$cmd" "$SVC"
    [[ $cmd == stop ]] || { wait_up; say "Работает: $(url)"; }
    ;;
  backup) admin backup ;;
  backups) admin backups ;;
  restore)
    [[ -n ${1:-} ]] || die "Укажите имя копии (sudo tbo-ctl backups) или путь к .zip"
    src=$1
    if [[ -f $src ]]; then                    # файл вне каталога копий — сделать читаемым для сервиса
      tmp=$(mktemp /tmp/tbo-restore-XXXXXX.zip); cp "$src" "$tmp"; chown "$SVC_USER" "$tmp"; src=$tmp
    fi
    say "Остановка сервиса"; systemctl stop "$SVC"
    admin restore "$src" || { systemctl start "$SVC"; die "Восстановление не выполнено"; }
    [[ ${tmp:-} ]] && rm -f "$tmp"
    systemctl start "$SVC"; wait_up; say "Готово: $(url)"
    ;;
  update)
    . "$ETC_DIR/install.conf"
    [[ -d $SRC_DIR/.git ]] || die "Каталог исходников $SRC_DIR не git-репозиторий — обновите файлы вручную и запустите install.sh --upgrade"
    say "Резервная копия перед обновлением"; admin backup --kind pre-update
    owner=$(stat -c %U "$SRC_DIR")
    say "git pull в $SRC_DIR"; runuser -u "$owner" -- git -C "$SRC_DIR" pull --ff-only
    "$SRC_DIR/deploy/raspberry-pi/install.sh" --upgrade --skip-apt
    ;;
  password)
    pw=${1:-}
    if [[ -z $pw ]]; then
      read -rsp "Новый пароль: " pw; echo
      read -rsp "Ещё раз: " pw2; echo
      [[ $pw == "$pw2" ]] || die "Пароли не совпадают"
    fi
    [[ $pw =~ ^[A-Za-z0-9._@+=:,%/!?#-]{6,64}$ ]] || die "Пароль: 6–64 символа, латиница, цифры и ._-@+=:,%/!?# (без пробелов и кавычек)"
    setenv TBO_AUTH_PASSWORD "$pw"
    systemctl restart "$SVC"; wait_up
    say "Пароль изменён. Пользователь: $(envget TBO_AUTH_USER). Браузер спросит его при следующем входе."
    ;;
  nopassword)
    setenv TBO_AUTH_PASSWORD ""
    systemctl restart "$SVC"; wait_up; say "Вход без пароля (любой в сети может вносить изменения)"
    ;;
  port)
    p=${1:-}; [[ $p =~ ^[0-9]+$ && $p -ge 1 && $p -le 65535 ]] || die "Укажите порт 1–65535"
    setenv TBO_PORT "$p"
    systemctl restart "$SVC"; wait_up; say "Адрес: $(url)"
    ;;
  reset-demo)
    read -rp "Пересоздать демо-данные? Все изменения будут потеряны [y/N] " a
    [[ $a == [yYдД]* ]] || exit 0
    admin backup; admin reset-demo
    ;;
  notify-test) admin notify-test ;;
  uninstall)
    systemctl disable --now "$SVC" 2>/dev/null || true
    rm -f "/etc/systemd/system/$SVC.service"; systemctl daemon-reload
    rm -rf "$APP_DIR"
    if [[ ${1:-} == --purge ]]; then
      rm -rf "$(envget TBO_DATA_DIR)" "$ETC_DIR"; userdel "$SVC_USER" 2>/dev/null || true
      say "Удалено вместе с данными"
    else
      say "Сервис удалён. Данные сохранены в $(envget TBO_DATA_DIR), настройки — в $ETC_DIR"
    fi
    rm -f /usr/local/bin/tbo-ctl
    ;;
  *) help; exit 1 ;;
esac
