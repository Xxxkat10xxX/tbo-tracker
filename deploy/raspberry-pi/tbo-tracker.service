[Unit]
Description=tbo-tracker — обслуживание БПЛА по фактической наработке
Documentation=https://github.com/Xxxkat10xxX/tbo-tracker/blob/main/docs/RASPBERRY_PI.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tbo
Group=tbo
SupplementaryGroups=video
EnvironmentFile=/etc/tbo-tracker/tbo.env
Environment=PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WorkingDirectory=/opt/tbo-tracker
# Один процесс: SQLite и фоновые задачи (уведомления, резервные копии) живут внутри него
ExecStart=/opt/tbo-tracker/.venv/bin/python -m uvicorn app.main:app --host ${TBO_HOST} --port ${TBO_PORT} --no-access-log --log-level warning --timeout-graceful-shutdown 10
Restart=always
RestartSec=3
TimeoutStopSec=20

# Порт 80 без прав root
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# Изоляция: запись только в каталог данных
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/tbo-tracker
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryMax=1G

[Install]
WantedBy=multi-user.target
